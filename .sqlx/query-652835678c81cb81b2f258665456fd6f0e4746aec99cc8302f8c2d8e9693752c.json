  "query": "\n        SELECT \n            user_id, \n            COUNT(order_id) as \"total_orders!\", \n            SUM(quantity) as \"total_quantity!\", \n            SUM(unit_price * quantity) as \"total_amount!\"\n        FROM import_rows \n        WHERE import_id = $1 \n        GROUP BY user_id\n        ORDER BY user_id\n        ",
